APP_DEBUG=false
APP_ENV=production
APP_KEY=
# Port to expose the app on (default: 80)
APP_PORT=80

DB_CONNECTION=pgsql
# When using Docker: set DB_HOST=postgres (overridden automatically by docker-compose)
DB_HOST=postgres
DB_DATABASE=watcher
DB_USERNAME=watcher
DB_PASSWORD=

TELESCOPE_ADMIN_EMAIL=

TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=
TELEGRAM_NOTIFY_BOT_TOKEN=
TELEGRAM_NOTIFY_GROUP_ID=
TELEGRAM_NOTIFY_BOT_WEBHOOK_URL=https://example.com/<token>/webhook
TELEGRAM_LOGGER_BOT_TOKEN=
TELEGRAM_LOGGER_CHAT_ID=

# PHP binary path (auto-set in Docker; change if using bare-metal)
HANDLER_PHP_BINARY=/usr/local/bin/php
